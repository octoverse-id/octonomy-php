# The PHP 7.4 line's PHPStan config. phpVersion 70400 belongs here and only here: on main it would
# flag every 8.x construct main deliberately uses, which the downgrade removes.
parameters:
    level: 8
    phpVersion: 70400
    # examples/ too: the 7.4 line ships it, and nothing else would notice an 8.x-only API in it,
    # since no test runs it.
    paths:
        - src
        - tests
        - examples
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # Rector de-promotes `public readonly ?string $name = null` into a property that keeps the
        # parameter's default and gains a @readonly tag. The constructor always assigns it, so the
        # default is never read, but PHPStan refuses a default on any readonly property. If Rector
        # stops doing this, PHPStan reports the ignore as unmatched and it must go.
        -
            identifier: property.readOnlyByPhpDocDefaultValue
        # PathAsIsCurlFactory narrows Guzzle's resource|\CurlHandle handle with `instanceof \CurlHandle`.
        # Rector's DowngradePhp80ResourceReturnToObjectRector rewrites that as
        # `is_resource($handle) || $handle instanceof \CurlHandle`, the check PHP 7.4 needs, since its cURL
        # handles are resources (SdkBuiltClientTest passes on this line). PHPStan for 7.4 knows no
        # \CurlHandle class, so it reports the class and the resource|\CurlHandle the check leaves for
        # curl_setopt(). An ignore that stops matching is reported, so these go when that check does.
        -
            identifier: class.notFound
            path: src/Http/PathAsIsCurlFactory.php
        -
            identifier: argument.type
            path: src/Http/PathAsIsCurlFactory.php
